<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 应用标题：姓名 + 学号 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/lab_subtitle"
            android:textSize="14sp" />

        <!-- ==================== 功能区 1 ==================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/zone1_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/zone1_input_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/zone1_btn_add" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/zone1_btn_clear" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/zone1_count_empty"
            android:textSize="12sp" />

        <!-- ScrollView 嵌套 LinearLayout：滚动显示动态添加的 TextView -->
        <ScrollView
            android:id="@+id/scrollZone1"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_zone1_scroll">

            <LinearLayout
                android:id="@+id/llDynamicContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp" />
        </ScrollView>

        <!-- ==================== 功能区 2 ==================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/zone2_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/zone2_prompt"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbAndroid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/zone2_option_android"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/zone2_option_web"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/zone2_option_game"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/zone2_option_data"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbScript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/zone2_option_script"
                android:textSize="14sp" />
        </RadioGroup>

        <Button
            android:id="@+id/btnAdvise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/zone2_btn_advise" />

        <TextView
            android:id="@+id/tvAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top|start"
            android:minLines="4"
            android:text="@string/zone2_advice_placeholder"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnLab1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_lab1" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
